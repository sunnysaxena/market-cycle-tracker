class HistoricalInstrumentSourceMapping(Base):
    __tablename__ = "historical_instrument_source_mappings"

    mapping_id: Mapped[int] = mapped_column(Integer, primary_key=True)
    mapping_code: Mapped[str] = mapped_column(String(200), unique=True, nullable=False)
    source_code: Mapped[str] = mapped_column(
        ForeignKey("historical_data_sources.source_code"), nullable=False
    )
    instrument_code: Mapped[str] = mapped_column(
        String(32), ForeignKey("index_master.code"), nullable=False
    )
    source_symbol: Mapped[str | None] = mapped_column(String(150), nullable=True)
    source_table: Mapped[str | None] = mapped_column(String(150), nullable=True)
    timeframe: Mapped[str] = mapped_column(String(10), nullable=False)
    mapping_role: Mapped[str] = mapped_column(String(40), nullable=False)
    valid_from: Mapped[date | None] = mapped_column(Date, nullable=True)
    valid_to: Mapped[date | None] = mapped_column(Date, nullable=True)
    priority: Mapped[int] = mapped_column(Integer, nullable=False, default=100)
    mapping_status: Mapped[str] = mapped_column(String(30), nullable=False)
    notes: Mapped[str | None] = mapped_column(Text, nullable=True)
    metadata_json: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False)
    created_at_utc: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), nullable=False
    )
    updated_at_utc: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), nullable=False
    )

    __table_args__ = (
        CheckConstraint(
            "mapping_role IN ('legacy_reference', 'preferred_for_period', "
            "'fallback_reference', 'supplemental', 'pending_review')",
            name="ck_hismap_role",
        ),
        CheckConstraint(
            "mapping_status IN ('active', 'inactive', 'pending_review')",
            name="ck_hismap_status",
        ),
        CheckConstraint(
            "valid_from IS NULL OR valid_to IS NULL OR valid_from <= valid_to",
            name="ck_hismap_valid_period",
        ),
        Index(
            "ix_hismap_instrument_period",
            "instrument_code",
            "valid_from",
            "valid_to",
        ),
        Index(
            "ix_hismap_instrument_timeframe_status",
            "instrument_code",
            "timeframe",
            "mapping_status",
            "priority",
        ),
    )


